package com.douglaasph.clinic_api.config.aws;

import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import software.amazon.awssdk.auth.credentials.AwsBasicCredentials;
import software.amazon.awssdk.auth.credentials.StaticCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.s3.S3Configuration;
import software.amazon.awssdk.services.s3.presigner.S3Presigner;

import java.net.URI;

/**
 * Como a API nao fala mais com o SQS diretamente (o pipeline agora e
 * disparado automaticamente via S3 -> SNS -> SQS -> Lambda), este
 * S3Config.java NAO precisa mais do bean SqsClient nem de dois endpoints
 * separados - so o S3Presigner, usado para gerar a URL de upload que o
 * NAVEGADOR do paciente vai usar.
 *
 * Por isso "aws.endpoint" volta a ser uma unica property (equivalente ao
 * S3Config.java original que voce mandou, so que sem o SqsClient).
 */
@Configuration
public class S3Config {

    @Value("${aws.endpoint:http://localhost:4566}")
    private String endpoint;

    @Value("${aws.region:us-east-1}")
    private String region;

    @Bean
    public S3Presigner s3Presigner() {
        return S3Presigner.builder()
                .endpointOverride(URI.create(endpoint))
                .region(Region.of(region))
                .credentialsProvider(StaticCredentialsProvider.create(
                        AwsBasicCredentials.create("test", "test")
                ))
                .serviceConfiguration(S3Configuration.builder()
                        .pathStyleAccessEnabled(true)
                        .build())
                .build();
    }
}
